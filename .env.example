# --- Backend API (server/) ---
# Postgres connection string. For production, use your Supabase project's
# connection string: Project Settings -> Database -> Connection string (URI).
# For local dev, point this at a local/Docker Postgres instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codestash

# Long random secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Access token lifetime
JWT_EXPIRES_IN=15m

PORT=4000

# --- Legacy (frontend still calls Supabase directly; not yet rewired to the backend above) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
ADMIN_PASSPHRASE=your-secret-passphrase
